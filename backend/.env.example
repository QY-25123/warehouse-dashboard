# ── Database ────────────────────────────────────────────────────────────────
# Supabase connection string (Project Settings → Database → Connection string,
# "Session mode" pooler URL, port 5432). Falls back to POSTGRES_* below if unset.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=changeme

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Claude (AI task planner, Gmail extraction, Telegram/WhatsApp agents) ─────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Telegram bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_USE_POLLING=true

# ── Google Sheets task intake ───────────────────────────────────────────────
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_OAUTH_JSON={"type": "service_account", ...}

# ── Gmail order intake ──────────────────────────────────────────────────────
GMAIL_CREDENTIALS_JSON={"token": "...", "refresh_token": "...", ...}

# ── Observability (Arize Phoenix Cloud) — optional, tracing disabled if unset
# Get PHOENIX_API_KEY from https://app.phoenix.arize.com → your space → Settings → API Keys.
# IMPORTANT: these must stay env vars, not explicit register(endpoint=..., api_key=...) kwargs
# in code — phoenix.otel only builds the correct Phoenix Cloud path (/s/<space>/v1/traces)
# when it reads the endpoint from the environment itself. See app/observability.py.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-name
PHOENIX_API_KEY=your-phoenix-cloud-api-key
PHOENIX_PROJECT_NAME=warehouse-dashboard
