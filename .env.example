# ── Production (Supabase + AWS + Vercel) ──────────────────────────────────────
# Set DATABASE_URL to your Supabase connection string.
# Get it from: Supabase dashboard → Project Settings → Database → Connection string (URI)
# Use the "Session mode" pooler URL (port 5432) for persistent connections.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Comma-separated list of allowed frontend origins (no trailing slash).
# Add your Vercel deployment URL here.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Supabase Auth (backend) ──────────────────────────────────────────────────
# Get these from: Supabase dashboard → Project Settings → API
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Frontend (set in Vercel dashboard or .env.local) ──────────────────────────
# Public URL of the deployed AWS backend.
NEXT_PUBLIC_API_URL=https://your-backend.example.com

# Supabase Auth (frontend — public keys only, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Local development only (ignored when DATABASE_URL is set) ─────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=changeme

# ── Observability (Arize Phoenix Cloud) — optional, tracing is disabled if unset
# Get PHOENIX_API_KEY from https://app.phoenix.arize.com → your space → Settings → API Keys.
# IMPORTANT: pass PHOENIX_COLLECTOR_ENDPOINT/PHOENIX_API_KEY only via env vars — never
# as explicit register(endpoint=..., api_key=...) kwargs in code. phoenix.otel only builds
# the correct Phoenix Cloud path (/s/<space>/v1/traces) when it reads the endpoint from
# the environment itself; passing it explicitly bypasses that and 405s. See
# backend/app/observability.py for the working setup.
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-name
PHOENIX_API_KEY=your-phoenix-cloud-api-key
PHOENIX_PROJECT_NAME=warehouse-dashboard
